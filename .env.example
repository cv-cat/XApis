# 复制成 .env 后填写。.env 已在 .gitignore 里，不会入库。

# 会话凭据（必填）。浏览器登录后，从任一 /i/api/graphql/** 请求的 cookie 头整串复制。
# 必需的是 auth_token 与 ct0，其余带上更像真实会话。
X_COOKIES='guest_id=...; twid=u%3D...; auth_token=...; ct0=...'

# 用户名密码（quickstart.py / main.py login 使用）。
# 若账号暂时被登录限流，请退避后再重试。
X_USERNAME=''
X_PASSWORD=''

# 可选：全局代理，如 http://127.0.0.1:7890
X_PROXY=''

# 可选：把同一浏览器会话采集到的 Castle Rl/raw profile 用于纯算登录。
# 纯算 live 验收时必须填写；当前 profile 只对应一次 Chrome 采集，不代表所有设备。
# CASTLE_PURE_RL_FILE='path/to/castle_profile.json'
# CASTLE_PURE_ONLY='1'  # 没有 profile 时拒绝 Node fallback

# 可选：仅做“浏览器 cookie + 密码流”对拍时打开；默认密码登录是干净会话。
# X_LOGIN_BROWSER_COOKIES='0'

# Web 控制台 / Docker Compose（默认仅本机可访问）
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8000
# 反向代理 HTTPS 部署时设置为实际访问地址，同时启用 Secure Cookie
CONSOLE_PUBLIC_URL=
CONSOLE_COOKIE_SECURE=0
# 本地 AI 服务显式放行的主机名，逗号分隔；热点源仍禁止内网访问
CONSOLE_PRIVATE_AI_HOSTS=
